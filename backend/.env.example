# ── PostgreSQL connection ────────────────────────────────────────────────────
# Local PostgreSQL:
#   postgresql://postgres:yourpassword@localhost:5432/trading_bot
# Supabase (cloud):
#   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
# Neon (cloud):
#   postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/trading_bot?sslmode=require
# Railway:
#   Copy from Railway dashboard → Your DB service → Connect tab
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/trading_bot

# ── Custom MT5 Bridge (File Bridge) ─────────────────────────────────────────
# Path to your MT5 terminal's MQL5/Files folder
# Example: C:\Users\Mastewal\AppData\Roaming\MetaQuotes\Terminal\<HASH>\MQL5\Files
MT4_FILES_DIR=C:\Users\YourName\AppData\Roaming\MetaQuotes\Terminal\YOURHASH\MQL5\Files
MT_BRIDGE_URL=http://localhost:5555
MT_BRIDGE_SECRET=bridge_secret_token

# ── Webhook security (TradingView → this bot) ────────────────────────────────
WEBHOOK_SECRET=your_secret_token_here

# ── Bot settings ─────────────────────────────────────────────────────────────
SYMBOL=XAUUSDm
ADAPTATION_INTERVAL=20
SIMULATION_MODE=true

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
